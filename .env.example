# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Shown in the X-Served-By header and page footer (web-01 / web-02).
SERVER_NAME=local
# Proxies in front of Node: 0 = none, 1 = nginx, 2 = HAProxy + nginx (production).
TRUST_PROXY=1

# --- Weather providers ----------------------------------------------------
# Open-Meteo (primary) needs no key.
# OpenWeatherMap is the automatic failover provider. Free key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
# open-meteo | openweathermap
PRIMARY_PROVIDER=open-meteo

# --- Performance / protection --------------------------------------------
WEATHER_CACHE_TTL_SECONDS=600
GEOCODE_CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=1000
UPSTREAM_TIMEOUT_MS=6000
RATE_LIMIT_PER_MINUTE=120
